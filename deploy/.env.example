# Gage Tracker — deployment configuration. Copy to deploy/.env and fill every REQUIRED value.
# Never commit deploy/.env. Example values below are placeholders, not usable secrets.

# --- Release
GT_VERSION=1.0.0-rc.1

# --- Public name (REQUIRED). DNS name users type in the browser.
GT_DOMAIN=gagetracker.example.com
# Leave empty for automatic public certificates; "internal" for a private network CA.
GT_TLS=

# --- Database (REQUIRED)
POSTGRES_USER=gagetracker
POSTGRES_PASSWORD=CHANGE-ME-long-random-password
POSTGRES_DB=gagetracker

# --- Secrets (REQUIRED). Generate them, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                     -> JWT_SECRET
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"       -> SECRET_ENCRYPTION_KEY
# Keep SECRET_ENCRYPTION_KEY in your secret store: without it encrypted webhook secrets cannot be read.
JWT_SECRET=CHANGE-ME
SECRET_ENCRYPTION_KEY=CHANGE-ME

# --- Security and behaviour (optional)
BCRYPT_ROUNDS=12
ACCESS_TOKEN_TTL_MINUTES=60
ALLOW_SELF_REGISTRATION=false
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
SCHEDULER_INTERVAL_SECONDS=30
