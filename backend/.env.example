# Copy to .env and adjust. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=postgresql+psycopg://gagetracker:gagetracker@localhost:5433/gagetracker
# Required in production: a random value of at least 32 characters.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ALLOW_SELF_REGISTRATION=true
# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://gagetracker:gagetracker@localhost:5433/gagetracker_test
# Uploaded documents (certificates, photos, evidence). Local directory for now;
# an S3-compatible backend can implement the same Storage interface.
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=20
